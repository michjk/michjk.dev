---
import { about, education } from "../data/portfolio";
import Icon from "./Icon.astro";
---

<section id="about" class="section">
  <div data-reveal="up">
    <div class="section-label">About</div>
  </div>

  <h2
    class="section-title"
    data-text-reveal
    data-stagger="40"
    style={{ display: "flex", flexWrap: "wrap", gap: "0 0.3em" }}
  >
    {"A few sentences.".split(/\s+/).map((word) => (
      <span style={{ overflow: "hidden", display: "inline-block" }}>
        <span data-word style={{ display: "inline-block" }}>{word}</span>
      </span>
    ))}
  </h2>

  <div style={{ maxWidth: "var(--prose-max)", fontSize: "15px", lineHeight: 1.7 }}>
    {about.map((para, i) => (
      <div data-reveal="up" data-delay={String(i * 80)}>
        <p style={{
          margin: "0 0 18px",
          color: i === 0 ? "var(--text-primary)" : "var(--text-secondary)",
        }}>
          {para}
        </p>
      </div>
    ))}
  </div>

  <!-- Education card -->
  <div data-reveal="up" data-delay="100">
    <div class="card-base" style={{
      marginTop: "32px",
      maxWidth: "var(--prose-max)",
      display: "flex",
      gap: "16px",
      alignItems: "flex-start",
      padding: "20px 24px",
    }}>
      <div style={{
        width: "40px",
        height: "40px",
        borderRadius: "var(--radius-md)",
        background: "var(--bg-overlay)",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        color: "var(--accent)",
        flexShrink: 0,
      }}>
        <Icon name="graduation-cap" size={18} />
      </div>
      <div style={{ flex: 1 }}>
        <div style={{ fontSize: "15px", fontWeight: 500, color: "var(--text-primary)" }}>{education.school}</div>
        <div style={{ fontSize: "14px", color: "var(--text-secondary)", marginTop: "4px" }}>
          {education.degree} — {education.specialization}
        </div>
        <div style={{
          fontFamily: "var(--font-mono)",
          fontSize: "12px",
          color: "var(--text-tertiary)",
          marginTop: "6px",
          display: "flex",
          gap: "16px",
          flexWrap: "wrap",
        }}>
          <span>{education.dates}</span>
          <span>{education.gpa}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupScrollReveals, setupTextReveals } from "../scripts/motion";
  setupScrollReveals();
  setupTextReveals();
</script>
