---
import { identity } from "../data/portfolio";
import Icon from "./Icon.astro";

const navItems = [
  { id: "experience", label: "Experience" },
  { id: "skills",     label: "Skills" },
  { id: "about",      label: "About" },
  { id: "contact",    label: "Contact" },
];
---

<nav
  id="site-nav"
  style={{
    position: "sticky",
    top: 0,
    zIndex: 50,
    width: "100%",
    height: "var(--nav-h)",
    background: "var(--bg-surface)",
    borderBottom: "1px solid var(--border-subtle)",
    transition: "background-color 150ms ease, backdrop-filter 150ms ease",
  }}
>
  <div style={{
    height: "100%",
    maxWidth: "var(--content-max)",
    margin: "0 auto",
    padding: "0 var(--margin)",
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between",
  }}>
    <a
      href="#top"
      style={{ fontFamily: "var(--font-mono)", fontSize: "14px", color: "var(--accent)", letterSpacing: "-0.01em" }}
    >
      {identity.handle}/
    </a>

    <div style={{ display: "flex", gap: "24px", alignItems: "center" }}>
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          style={{ fontSize: "13px", color: "var(--text-secondary)", transition: "color 150ms ease", cursor: "pointer" }}
        >
          {item.label}
        </a>
      ))}

      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <span id="theme-icon-sun" style={{ display: "none" }}><Icon name="sun" size={14} /></span>
        <span id="theme-icon-moon"><Icon name="moon" size={14} /></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("site-nav")!;
  const links = document.querySelectorAll<HTMLElement>("[data-nav-link]");
  const themeToggle = document.getElementById("theme-toggle")!;
  const iconSun = document.getElementById("theme-icon-sun")!;
  const iconMoon = document.getElementById("theme-icon-moon")!;
  const sections = ["experience", "skills", "about", "contact"];

  /* Blur nav on scroll */
  const isDark = () => document.documentElement.classList.contains("dark");

  function updateNavBg(scrolled: boolean) {
    if (scrolled) {
      nav.style.background = isDark()
        ? "rgba(13,17,23,0.72)"
        : "rgba(255,255,255,0.78)";
      nav.style.backdropFilter = "blur(8px)";
      (nav.style as any).webkitBackdropFilter = "blur(8px)";
    } else {
      nav.style.background = "var(--bg-surface)";
      nav.style.backdropFilter = "";
      (nav.style as any).webkitBackdropFilter = "";
    }
  }

  window.addEventListener("scroll", () => updateNavBg(window.scrollY > 120), { passive: true });

  /* Scroll spy */
  function setActive(id: string) {
    for (const link of links) {
      const isActive = link.dataset.navLink === id;
      link.style.color = isActive ? "var(--accent)" : "var(--text-secondary)";
    }
  }

  window.addEventListener("scroll", () => {
    const y = window.scrollY + window.innerHeight * 0.35;
    let current = sections[0];
    for (const id of sections) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) current = id;
    }
    setActive(current);
  }, { passive: true });

  /* Nav link hover */
  for (const link of links) {
    link.addEventListener("mouseenter", () => {
      if (link.style.color !== "var(--accent)") link.style.color = "var(--text-primary)";
    });
    link.addEventListener("mouseleave", () => {
      if (link.style.color !== "var(--accent)") link.style.color = "var(--text-secondary)";
    });
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = link.dataset.navLink!;
      const target = document.getElementById(id);
      if (target) {
        const top = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: "smooth" });
      }
      setActive(id);
    });
  }

  /* Theme toggle */
  function syncThemeIcons() {
    const dark = isDark();
    iconSun.style.display = dark ? "flex" : "none";
    iconMoon.style.display = dark ? "none" : "flex";
    updateNavBg(window.scrollY > 120);
  }

  syncThemeIcons();

  themeToggle.addEventListener("click", () => {
    const html = document.documentElement;
    const newTheme = isDark() ? "light" : "dark";
    html.classList.remove("dark", "light");
    html.classList.add(newTheme);
    localStorage.setItem("theme", newTheme);
    syncThemeIcons();
  });
</script>
